{
  "manifest_version": 3,
  "name": "Coverage – IB Networking",
  "short_name": "Coverage",
  "version": "0.1.0",
  "description": "Send the LinkedIn profile or search you're viewing to your Coverage dashboard in one click.",
  "homepage_url": "https://banker-dashboard-three.vercel.app",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Coverage",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "minimum_chrome_version": "102"
}

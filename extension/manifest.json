{
  "manifest_version": 3,
  "name": "Coverage – IB Networking",
  "short_name": "Coverage",
  "version": "1.1.0",
  "description": "Add LinkedIn bankers to your Coverage tracker and fill job applications from your saved info. You review and submit.",
  "homepage_url": "https://banker-dashboard-three.vercel.app",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://banker-dashboard-three.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content/dashboard.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Coverage",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "side_panel": {
    "default_path": "agent/panel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "minimum_chrome_version": "116"
}

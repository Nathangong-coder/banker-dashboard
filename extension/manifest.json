{
  "manifest_version": 3,
  "name": "Coverage – IB Networking",
  "short_name": "Coverage",
  "version": "1.8.1",
  "description": "Track LinkedIn bankers and jobs in Coverage, and fill job applications from your saved info. You review and submit.",
  "homepage_url": "https://banker-dashboard-three.vercel.app",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabGroups",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkdaysite.com/*",
    "https://*.workday.com/*",
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.ashbyhq.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.icims.com/*",
    "https://*.taleo.net/*",
    "https://*.oraclecloud.com/*",
    "https://*.successfactors.com/*",
    "https://*.successfactors.eu/*",
    "https://*.jobvite.com/*",
    "https://*.brassring.com/*",
    "https://*.eightfold.ai/*",
    "https://*.avature.net/*",
    "https://*.workable.com/*",
    "https://www.linkedin.com/*",
    "https://*.joinhandshake.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://banker-dashboard-three.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content/dashboard.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Coverage",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "side_panel": {
    "default_path": "agent/panel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "minimum_chrome_version": "116"
}
